<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 只需要联网。刻意不申请任何定位权限。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：手机揣兜里 11 分钟，进程不能被系统随手杀掉 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CPU 锁：息屏后不让 CPU 睡过去，否则 sleep 会睡过头把整轮拖长 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 电池优化白名单：深度 Doze 会连 wake lock 一起忽略，只有进白名单才彻底 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusRun"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="author"
            android:value="@string/app_author" />
        <meta-data
            android:name="version"
            android:value="1.9.0" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 设置页：账号 openid / 主题 / 统计 / 取码 / 教程 / 说明 / 开源仓库 -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <!-- 日志页：完整运行日志 -->
        <activity
            android:name=".LogActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/log_page"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".RunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 把提取脚本当文件分享出去（发到微信文件传输助手，电脑上直接打开） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
