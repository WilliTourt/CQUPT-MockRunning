<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/panelRun"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="92dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">

        <!-- ═══════════ 跑步参数 ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="@string/l_pace" />

                <EditText
                    android:id="@+id/etPace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/box"
                    android:hint="5:45"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:padding="10dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/fg_dim"
                    android:textSize="19sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Label"
                    android:text="@string/l_dist" />

                <EditText
                    android:id="@+id/etDist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/box"
                    android:hint="2.0"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:padding="10dp"
                    android:textColor="@color/fg"
                    android:textColorHint="@color/fg_dim"
                    android:textSize="19sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 配速抖动：平均配速被夹在「上面的配速 ± 这个值」之内 -->
        <TextView
            style="@style/Label"
            android:layout_marginTop="16dp"
            android:text="@string/l_pace_tol" />

        <EditText
            android:id="@+id/etTol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/box"
            android:hint="20"
            android:inputType="number"
            android:maxLines="1"
            android:padding="10dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg_dim"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/tvPaceWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />

        <!-- ═══════════ 主按钮：开始 ↔ 结束，同一个 ═══════════ -->
        <!-- 放在配速抖动下面，而不是页面最顶上 —— 顶到头的话大拇指够不着 -->
        <Button
            android:id="@+id/btnRun"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_solid"
            android:text="@string/b_run"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ═══════════ 仪表盘 ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/box"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dash_progress"
                    android:textColor="@color/fg_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="@color/accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/tvDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/dash_idle_distance"
                android:textColor="@color/fg"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dash_idle_time"
                android:textColor="@color/fg"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvPaceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dash_idle_pace"
                android:textColor="@color/fg_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvBatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dash_idle_batch"
                android:textColor="@color/fg_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvServer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/dash_idle_server"
                android:textColor="@color/ok"
                android:textSize="15sp" />

            <!-- 省电模式提示：不影响打卡，只影响通知栏刷新频率 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/power_save_tip"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 电池优化状态：深度 Doze 会连 wake lock 一起忽略，只有进白名单才彻底 -->
        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/box"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:text="@string/batt_unknown"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
