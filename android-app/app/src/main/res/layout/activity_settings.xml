<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：固定顶栏（「设置」+ 返回箭头），下面按分组排列。
  openid 输入在这里，主页只留打卡参数。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- ═══════════ 固定顶栏 ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="@color/fg"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/settings"
            android:textColor="@color/fg"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ═══════════ 账号 ═══════════ -->
            <TextView
                style="@style/Label"
                android:layout_marginTop="4dp"
                android:text="@string/grp_account" />

            <EditText
                android:id="@+id/etOpenid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box"
                android:hint="@string/h_openid"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="@color/fg"
                android:textColorHint="@color/fg_dim"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/b_connect"
                android:textAllCaps="false"
                android:textColor="@color/accent" />

            <!-- openid 怎么拿：收进折叠区，不占主页 -->
            <Button
                android:id="@+id/btnToggleOpenidHelp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_ghost"
                android:text="@string/b_openid_help"
                android:textAllCaps="false"
                android:textColor="@color/fg_dim"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/panelOpenidHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/box"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/help_body"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCopyScript"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_solid"
                        android:text="@string/b_copy_script"
                        android:textAllCaps="false"
                        android:textColor="@color/on_accent"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnShareScript"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/btn_ghost"
                        android:text="@string/b_share_script"
                        android:textAllCaps="false"
                        android:textColor="@color/accent"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnToggleScript"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_ghost"
                    android:text="@string/b_view_script"
                    android:textAllCaps="false"
                    android:textColor="@color/fg_dim"
                    android:textSize="14sp" />

                <ScrollView
                    android:id="@+id/scriptScroll"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/box"
                    android:fillViewport="true"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvScript"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/log"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </ScrollView>

                <TextView
                    android:id="@+id/tvScriptPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ═══════════ 主题 ═══════════ -->
            <TextView
                style="@style/Label"
                android:layout_marginTop="22dp"
                android:text="@string/l_theme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/seg_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/segThemeAuto"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/seg_selected"
                    android:gravity="center"
                    android:text="@string/theme_auto_plain"
                    android:textColor="@color/on_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/segThemeDark"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/seg_normal"
                    android:gravity="center"
                    android:text="@string/theme_dark_plain"
                    android:textColor="@color/fg_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/segThemeLight"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/seg_normal"
                    android:gravity="center"
                    android:text="@string/theme_light_plain"
                    android:textColor="@color/fg_dim"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- ═══════════ 成绩统计 ═══════════ -->
            <TextView
                style="@style/Label"
                android:layout_marginTop="22dp"
                android:text="@string/l_stats" />

            <Button
                android:id="@+id/btnRefreshStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_ghost"
                android:text="@string/b_refresh_stats"
                android:textAllCaps="false"
                android:textColor="@color/accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/box"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvStatsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/stats_hint"
                    android:textColor="@color/fg"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                style="@style/Label"
                android:layout_marginTop="14dp"
                android:text="@string/l_stats_place" />

            <TextView
                android:id="@+id/tvStatsByPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box"
                android:lineSpacingExtra="5dp"
                android:padding="12dp"
                android:text="@string/stats_dash"
                android:textColor="@color/log"
                android:textSize="15sp" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="14dp"
                android:text="@string/l_stats_list" />

            <TextView
                android:id="@+id/tvStatsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:text="@string/stats_dash"
                android:textColor="@color/log"
                android:textSize="13sp" />

            <!-- ═══════════ 使用教程 ═══════════ -->
            <TextView
                style="@style/Label"
                android:layout_marginTop="22dp"
                android:text="@string/tutorial_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box"
                android:lineSpacingExtra="6dp"
                android:padding="14dp"
                android:text="@string/tutorial_body"
                android:textColor="@color/fg"
                android:textSize="14sp" />

            <!-- ═══════════ 说明 ═══════════ -->
            <TextView
                style="@style/Label"
                android:layout_marginTop="22dp"
                android:text="@string/about_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/box"
                android:lineSpacingExtra="6dp"
                android:padding="14dp"
                android:text="@string/about_body"
                android:textColor="@color/fg"
                android:textSize="14sp" />

            <!-- 开源仓库 -->
            <TextView
                android:id="@+id/tvRepo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/box"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:text="@string/repo_link"
                android:textColor="@color/accent"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnCopyRepo"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_ghost"
                android:gravity="center"
                android:text="@string/b_copy_repo"
                android:textColor="@color/fg_dim"
                android:textSize="14sp" />

            <!-- ═══════════ 署名 ═══════════ -->
            <TextView
                android:id="@+id/tvCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:lineSpacingExtra="4dp"
                android:text="@string/credit"
                android:textColor="@color/fg_dim"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
